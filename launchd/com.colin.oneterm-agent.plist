<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.colin.oneterm-serve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/workspace/oneterm/bin/oneterm</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/you/Library/Logs/oneterm-serve.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/you/Library/Logs/oneterm-serve.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/you</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/you/.local/bin</string>
    </dict>
</dict>
</plist>
